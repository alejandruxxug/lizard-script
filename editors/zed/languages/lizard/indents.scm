; A block, a bracket pair and the body of a layer indent the lines inside.
(block "}" @end) @indent
(hash "}" @end) @indent
(array "]" @end) @indent
(arguments ")" @end) @indent
(parameters ")" @end) @indent
(point ")" @end) @indent
(parenthesized_expression ")" @end) @indent
(layer_statement) @indent
