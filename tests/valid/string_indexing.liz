-~> Indexing and len count characters, in plain and non-ASCII text
let s = "añ🦎b"
puts(len(s))
let i = 0
while (i < len(s)) {
  puts(i, s[i])
  i += 1
}
puts(s[4], s[-1])
puts(text.slice(s, 1, 3), text.find(s, "b"), text.code(s, 2))

let word = ""
for (let k = 0; k < 2000; k += 1) { word = word + "xyz" }
let count = 0
for (let k = 0; k < len(word); k += 1) {
  if (word[k] == "y") { count += 1 }
}
puts(count)
