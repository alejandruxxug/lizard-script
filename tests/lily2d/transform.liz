-~> Matrices, and shapes moved by them.
use "flower/lily2d" as lily2d
use "golden"

let m = lily2d.combine(lily2d.rotate(90deg), lily2d.translate((10, 0)))
puts(lily2d.apply(m, (1, 0)))
puts(lily2d.apply(lily2d.scale((2, 3), (1, 1)), (2, 2)))
puts(lily2d.apply(lily2d.combine(m, lily2d.invert(m)), (5, 7)))
puts(lily2d.identity())

let w = img.new(240, 240, #ffffff)
let petal = lily2d.ellipse(null, (120, 70), (18, 45), {"fill": lily2d.linear_at((120, 25), (120, 115), [#f2a65a, #e0607a]), "stroke": #3b2a5c, "width": 2, "dash": [6, 3]})
for (let i = 0; i < 8; i += 1) {
  lily2d.draw(w, lily2d.transform(petal, lily2d.rotate(i * 45deg, (120, 120))))
}
lily2d.draw(w, lily2d.transform(lily2d.star(null, (0, 0), 5, 20, 8, #f6c453), lily2d.combine(lily2d.scale(1.2), lily2d.translate((120, 120)))))
check("transform", w)
