-~> Every shape in one scene: lights of the three kinds, smooth and flat
-~> shading, a highlight, a wireframe over a face, fog and a floor cut by
-~> the near plane.
use "flower/lily3d" as lily3d
use "golden"

let picture = img.new(240, 160)
let s = lily3d.scene({"background": #1d1b22, "fog": {"color": #1d1b22, "near": 4, "far": 12}})
lily3d.light(s, lily3d.ambient(#ffffff, 0.25))
lily3d.light(s, lily3d.directional((-0.5, -1, -0.7), #fff4e0, 0.8))
lily3d.light(s, lily3d.point_light((0, 1.5, 1.5), #5aa0f2, 1, 4))
lily3d.add(s, lily3d.plane(16, 8), lily3d.translate((0, -0.5, 0)), {"color": #3a3f4a})
let shapes = [lily3d.cube(0.9), lily3d.sphere(0.5, 16), lily3d.cylinder(0.5, 1, 12), lily3d.cone(0.5, 1, 12), lily3d.torus(0.35, 0.15, 16, 8)]
let colors = [#f2a65a, #e2557b, #3fa34d, #f6c453, #7a6ff0]
for (let i = 0; i < len(shapes); i += 1) {
  let material = {"color": colors[i], "shine": 32}
  if (i == 0) {
    material.shading = "flat"
  }
  if (i == 4) {
    material.wireframe = #ffffff
  }
  lily3d.add(s, shapes[i], lily3d.compose([lily3d.rotate_x(25deg), lily3d.rotate_y(20deg * i), lily3d.translate(((i - 2) * 1.3, 0.1, -i * 0.6))]), material)
}
puts("triangles:", lily3d.render(s, lily3d.camera((0, 1.2, 4), (0, 0, -1), 60deg), picture))
check("render", picture)
