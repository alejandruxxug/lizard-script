-~> Reading .obj files.
use "flower/lily3d" as lily3d

-~> A square of two faces given as one quad, with a comment, a group and
-~> texture coordinates that are skipped.
let square = lily3d.parse_obj("# a square
o square
v 0 0 0
v 1 0 0
v 1 1 0
v 0 1 0
vt 0 0
f 1 2 3 4   # one quad
")
puts("quad", square.positions, square.faces, square.normals[0])

-~> Normals given with a//n: a corner per position and normal.
let lit = lily3d.parse_obj("v 0 0 0\nv 1 0 0\nv 0 1 0\nvn 0 0 2\nvn 0 0 -1\nf 1//1 2//1 3//1\nf 1//2 3//2 2//2\n")
puts("normals", len(lit.positions), lit.faces, lit.normals)
-~> Negative numbers count back, a/t/n is read too, and tabs split words.
let back = lily3d.parse_obj("v 0 0 0\nv 1 0 0\nv\t0\t1\t0\nvn 0 0 1\nf -3/1/1 -2/1/1 -1/1/1\n")
puts("from the end", back.faces, back.positions[2])

-~> The teapot of the examples.
let pot = lily3d.load_obj(fs.join(os.program_dir(), "../../examples/lily3d/teapot.obj"))
puts("teapot", len(pot.positions), "corners", len(pot.faces), "faces")

let bad = ["v 1 2\n", "v 1 x 3\n", "v 0 0 0\nf 1 2\n", "v 0 0 0\nf 1 2 3\n", "v 0 0 0\nv 0 0 0\nv 0 0 0\nf 1 2 0\n", "v 0 0 0\nv 0 0 0\nv 0 0 0\nf 1//1 2//1 3//1\n"]
for (let i = 0; i < len(bad); i += 1) {
  try {
    lily3d.parse_obj(bad[i])
  } catch (e) {
    puts(e.message)
  }
}
try {
  lily3d.load_obj(fs.join(os.program_dir(), "none.obj"))
} catch (e) {
  puts(text.slice(e.message, 0, 19))
}
