-~> Arrays and hashes are shared, so a function can change them.

let lizards = [
  {"name": "Liz", "toes": [5, 5, 5, 5], "age": 3},
  {"name": "Iggy", "toes": [5, 5, 4, 5], "age": 7},
  {"name": "Gecko", "toes": [5, 5, 5, 5], "age": 1}
]

function totalToes(lizard) {
  let total = 0
  for (let i = 0; i < len(lizard["toes"]); i = i + 1) {
    total = total + lizard["toes"][i]
  }
  total
}

function birthday(lizard) {
  lizard["age"] = lizard["age"] + 1
}

let i = 0
while (true) {
  if (i == len(lizards)) {
    break
  }
  let lizard = lizards[i]
  birthday(lizard)
  puts(lizard["name"] + " is " + str(lizard["age"]) + " and has " + str(totalToes(lizard)) + " toes")
  i = i + 1
}

-~> == converts between types, === doesn't.
puts("3 == the string 3 is", 3 == "3", "but 3 === the string 3 is", 3 === "3")
