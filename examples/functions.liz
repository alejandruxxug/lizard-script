-~> Recursion, closures and functions as values.

function fib(n) {
  if (n < 2) {
    return n
  }
  return fib(n - 1) + fib(n - 2)
}

puts("fib(20) =", fib(20))

-~> map is not a builtin, but it is easy to write.
function map(list, f) {
  let result = []
  for (let i = 0; i < len(list); i = i + 1) {
    push(result, f(list[i]))
  }
  return result
}

function makeCounter() {
  let count = 0
  return function() {
    count = count + 1
    return count
  }
}

let squares = map(range(1, 6), function(x) { x ** 2 })
puts("squares:", squares)

let counter = makeCounter()
counter()
counter()
puts("the counter is at", counter())
